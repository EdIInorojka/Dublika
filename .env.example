# Public HTTPS address of the media API. Required when deploying the static
# frontend to Vercel or any host other than the local Node server.
VITE_API_ORIGIN=https://api.example.ru

# Server network and media runtime. Keep 127.0.0.1 locally; use 0.0.0.0 only
# behind a HTTPS reverse proxy with DUBLIKA_ALLOWED_ORIGINS set.
DUBLIKA_HOST=127.0.0.1
DUBLIKA_PUBLIC_ORIGIN=https://app.example.ru
DUBLIKA_API_ORIGIN=https://api.example.ru
DUBLIKA_ALLOWED_ORIGINS=https://app.example.ru
DUBLIKA_MAX_CONCURRENT_RENDERS=2
DUBLIKA_DEMUCS_DEVICE=cpu
DUBLIKA_VIDEO_PRESET=veryfast
DUBLIKA_VIDEO_CRF=21
# Optional: lets yt-dlp use an authenticated YouTube browser session to pass
# YouTube's anti-bot check. Allowed: chrome, edge, brave, chromium, firefox,
# opera. Never commit a cookies.txt file or a personal browser profile.
DUBLIKA_YTDLP_COOKIES_FROM_BROWSER=
# Preferred when Chrome has Application-Bound Encryption: a path to a
# short-lived Netscape cookies.txt created only for a dedicated YouTube
# account. This file must stay outside Git and must not be uploaded anywhere.
DUBLIKA_YTDLP_COOKIES_FILE=

# Server-only values. Put real values in the server environment / secret
# store, never in a Vite-prefixed variable or committed file.
DEEPGRAM_API_KEY=
RESEND_API_KEY=
OTP_FROM_EMAIL=

# Payments: create these only in your server secret store. Point the YooKassa
# payment.succeeded webhook to https://api.example.ru/api/billing/yookassa.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# OAuth: configure only the providers you have registered. Each callback is
# https://api.example.ru/api/auth/oauth/<provider>/callback.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=
OAUTH_VK_AUTHORIZE_URL=
OAUTH_VK_TOKEN_URL=
OAUTH_VK_USERINFO_URL=
