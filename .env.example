# Public HTTPS address of the media API. Required when deploying the static
# frontend to Vercel or any host other than the local Node server.
VITE_API_ORIGIN=https://api.example.ru

# Server-only values. Put real values in the server environment / secret
# store, never in a Vite-prefixed variable or committed file.
DEEPGRAM_API_KEY=
RESEND_API_KEY=
OTP_FROM_EMAIL=
